---
import SiteLayout from "../layouts/SiteLayout.astro";
import SearchBox from "../components/ui/SearchBox.astro";
import ToolCard from "../components/ui/ToolCard.astro";
import CategoryToolLink from "../components/tools/CategoryToolLink.astro";
import CategoryVisual from "../components/tools/CategoryVisual.astro";
import { categoryMeta, tools } from "../tools/registry";
import type { ToolCategory } from "../tools/types";
import { getWebsiteStructuredData } from "../lib/seo";

const featuredTools = tools.filter((tool) => tool.featured).slice(0, 6);
const categories = Object.keys(categoryMeta) as ToolCategory[];
const description = "DoMyFile makes supported image, PDF, audio, and video tasks feel simple, private, and browser-first, with temporary processing disclosed where needed.";
---

<SiteLayout
  title="DoMyFile — Simple file tools that just work."
  description={description}
  structuredData={getWebsiteStructuredData(description)}
>
  <main id="main-content">
    <section class="view home-view" aria-labelledby="heroTitle">
      <div class="container">
        <section class="hero">
          <div class="hero-copy">
            <p class="section-kicker hero-kicker">Browser-first file tools · no upload by default</p>
            <h1 id="heroTitle">Simple file tools <span class="gradient-text">that just work.</span></h1>
            <p class="hero-description">
              Convert, compress, and edit supported images, PDFs, audio, and video with a clear select-to-download workflow. Browser tools stay on your device; the two server-bound compression tools disclose temporary upload and automatic deletion.
            </p>

            <SearchBox variant="hero" id="heroSearchInput" />

            <p class="client-side-callout"><strong>Private by design.</strong> Browser-tool files stay on your device. Server-bound compression routes explain their temporary upload and automatic deletion before processing.</p>
          </div>

          <div class="hero-visual" aria-label="Example of a local file transformation">
            <div class="hero-visual-frame">
              <div class="hero-visual-heading"><span>Local file workspace</span><span>DoMyFile</span></div>
              <div class="hero-visual-flow">
                <article class="file-card file-card--source file-card--float-one">
                  <div class="file-card-topline"><span class="file-card-kicker">Input file</span><span class="file-card-state">Original</span></div>
                  <div class="file-card-name">photo.png</div>
                  <div class="file-card-meta">3.8 MB <span class="meta-separator">·</span> 1920 × 1080</div>
                </article>

                <div class="conversion-connector" aria-hidden="true">
                  <span class="connector-line"></span>
                  <span class="connector-label">Compress locally</span>
                  <span class="connector-line"></span>
                </div>

                <article class="file-card file-card--result file-card--float-two">
                  <div class="file-card-topline"><span class="file-card-kicker">Browser result</span><span class="file-card-state">Ready</span></div>
                  <div class="file-card-name">photo.webp</div>
                  <div class="file-card-result"><strong>0.9 MB</strong><span>77% smaller</span></div>
                </article>
              </div>
              <div class="hero-visual-footer"><span>Original file stays on device</span><span>Nothing uploaded</span></div>
            </div>
          </div>
        </section>

        <section class="section section--popular" aria-labelledby="popularTitle">
          <div class="section-heading-row">
            <div>
              <p class="section-kicker">Start here</p>
              <h2 id="popularTitle">Popular tools</h2>
            </div>
            <a class="text-link" href="/tools/">Browse all tools</a>
          </div>
          <div class="tool-grid tool-grid--popular">
            {featuredTools.map((tool) => <ToolCard tool={tool} />)}
          </div>
        </section>

        <section class="section category-section" id="categorySections" aria-labelledby="categoriesTitle">
          <div class="section-heading-row section-heading-row--categories">
            <div>
              <p class="section-kicker">One system, every format</p>
              <h2 id="categoriesTitle">Find the right fix</h2>
            </div>
            <p class="section-heading-note">A small set of useful tools for the files you work with every day.</p>
          </div>
          <div class="category-list">
            {categories.map((category) => {
              const meta = categoryMeta[category];
              const categoryTools = tools.filter((tool) => tool.category === category).slice(0, 4);
              return (
                <article class="category-row">
                  <div class="category-row-copy">
                    <div>
                      <span class="category-index">{meta.number}</span>
                      <h3>{meta.label}</h3>
                      <p>{meta.description}</p>
                    </div>
                    <a class="category-row-link" href={`/${category}/`}>View all {meta.label} tools</a>
                  </div>
                  <div class="category-row-tools">
                    {categoryTools.map((tool) => <CategoryToolLink tool={tool} />)}
                  </div>
                  <div class="category-row-visual" aria-hidden="true"><CategoryVisual category={category} /></div>
                </article>
              );
            })}
          </div>
        </section>

        <section class="privacy-section" id="privacy" aria-labelledby="privacyTitle">
          <div class="privacy-copy">
            <p class="section-kicker">Built for peace of mind</p>
            <h2 id="privacyTitle">Files stay yours.</h2>
            <p>DoMyFile handles files on your device whenever supported. Compress PDF and Compress Video disclose temporary upload and automatic deletion before processing.</p>
            <a class="text-link" href="/privacy/">Read the privacy details</a>
          </div>
          <div class="privacy-points">
            <div class="privacy-point"><div><strong>Local by default</strong><span>Your file starts and ends on this device.</span></div></div>
            <div class="privacy-point"><div><strong>No account needed</strong><span>Open a tool and get to work immediately.</span></div></div>
            <div class="privacy-point"><div><strong>Clear about limits</strong><span>Unsupported formats are explained before processing.</span></div></div>
          </div>
        </section>
      </div>
    </section>
  </main>
</SiteLayout>
