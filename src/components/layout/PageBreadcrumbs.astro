---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li>
      <span class="breadcrumb-separator" aria-hidden="true">›</span>
      <span aria-current="page">{label}</span>
    </li>
  </ol>
</nav>
